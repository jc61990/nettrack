# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nettrack:changeme@localhost:5432/nettrack

# ── CORS / Host security ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://nettrack.yourcompany.com
# Comma-separated list of allowed Host header values
ALLOWED_HOSTS=nettrack.yourcompany.com,localhost

# ── Token expiry ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── SSO / OIDC (optional) ─────────────────────────────────────────────────────
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Azure AD:  https://login.microsoftonline.com/{tenant-id}/v2.0
# Okta:      https://{domain}.okta.com/oauth2/default
# Google:    https://accounts.google.com
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=https://nettrack.yourcompany.com/api/auth/callback
OIDC_DEFAULT_ROLE=read_only
FRONTEND_URL=https://nettrack.yourcompany.com

# ── Scanner SNMP credentials ──────────────────────────────────────────────────
SNMP_COMMUNITY=public
SNMP_V3_USERNAME=
SNMP_V3_AUTH_KEY=
SNMP_V3_PRIV_KEY=
SNMP_V3_AUTH_PROTOCOL=sha
SNMP_V3_PRIV_PROTOCOL=aes
SCANNER_API_TOKEN=

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to disable /api/docs
ENVIRONMENT=production
