# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nettrack:changeme@localhost:5432/nettrack

# ── CORS / Host security ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://nettrack.yourcompany.com
# Comma-separated list of allowed Host header values
ALLOWED_HOSTS=nettrack.yourcompany.com,localhost

# ── Token expiry ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Scanner SNMP credentials ──────────────────────────────────────────────────
SNMP_COMMUNITY=public
SNMP_V3_USERNAME=
SNMP_V3_AUTH_KEY=
SNMP_V3_PRIV_KEY=
SNMP_V3_AUTH_PROTOCOL=sha
SNMP_V3_PRIV_PROTOCOL=aes
SCANNER_API_TOKEN=

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to disable /api/docs
ENVIRONMENT=production
